# Telegram bot token from @BotFather (also used to verify Mini App logins)
BOT_TOKEN=
# Frontend URL (must be HTTPS for Telegram)
WEBAPP_URL=https://nihongo-xxx.vercel.app
# Postgres for user progress (free: neon.tech). Leave empty to use data/users.sqlite locally.
DATABASE_URL=
# Any long random text. Protects /cron and /telegram/setup.
CRON_SECRET=
# Allowed frontend origins, comma-separated (* = any)
CORS_ORIGINS=*
# Only for an always-on server: run the bot inside the API with polling (start.sh sets this)
# RUN_BOT=1
# Local testing without Telegram: trusts the X-Dev-User header. Never in production.
# DEV_MODE=1
