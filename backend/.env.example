# Telegram bot token from @BotFather (also used to verify Mini App logins)
BOT_TOKEN=
# Where the frontend is hosted (must be HTTPS for Telegram)
WEBAPP_URL=https://nihongo-xxx.vercel.app
# 1 = run the bot inside the API process (recommended: start.sh does this)
RUN_BOT=1
# Allowed frontend origins, comma-separated (* = any)
CORS_ORIGINS=*
# Where user progress is stored. On Railway/Render point this at a persistent volume.
# USER_DB=/data/users.sqlite
# Local testing without Telegram: DEV_MODE=1 trusts the X-Dev-User header. Never in production.
# DEV_MODE=1
